{
  "name": "@sf/client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "//": "Пакет @sf/shared резолвится алиасом в vite.config.ts и tsconfig.paths (файловая ситема устройства не поддерживает symlink).",
  "scripts": {
    "dev": "node node_modules/vite/bin/vite.js",
    "build": "node node_modules/typescript/bin/tsc -p tsconfig.json --noEmit && node node_modules/vite/bin/vite.js build",
    "preview": "node node_modules/vite/bin/vite.js preview",
    "typecheck": "node node_modules/typescript/bin/tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@colyseus/sdk": "^0.18.4",
    "phaser": "^3.90.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.0",
    "vite": "^8.3.1"
  }
}